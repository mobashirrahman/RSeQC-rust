{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1",
        "apiKey": "{env:TOKENROUTER_API_KEY}"
      },
      "models": {
        "z-ai/glm-5.3-free": {
          "name": "GLM-5.3 (free, via TokenRouter)",
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      }
    },
    "bai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "B.AI",
