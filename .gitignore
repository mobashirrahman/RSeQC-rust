.env
.opencode/node_modules/
oracle/upstream-src/
oracle/venv/
oracle/python313/
/target/
/dist/
/.claude/scheduled_tasks.lock
__pycache__/
*.pyc
benchmarks/workloads/
benchmarks/benchmark_results/

# T4 real-data panel: every byte under datasets/ except the manifest, the
# fetch/align scripts, and the logs that record what was fetched. The reads,
# the reference, the STAR index and the resulting BAMs are all regenerable from
# datasets/fetch_reference.sh + datasets/fetch_fastq.py + the pinned digests
# below, so committing them would mean committing ~4 GB of data that can only
# be verified by re-deriving it.
datasets/reference/
datasets/raw/
datasets/aligned/
datasets/star_index/
datasets/logs/*.log
datasets/logs/run_metadata.json

# Regenerated on demand by run_diff.py; only reads.bam/.bai and model.bed12 are committed
verification/fixtures/genebody_coverage_float/*.fastq
verification/fixtures/genebody_coverage_float/manifest.json

# T4 held-out stratum reads: 9.5 GB of FASTQ, regenerable from the run
# accessions recorded in datasets/manifest.yaml via datasets/fetch_fastq.py
# (per-run MD5 verified against the archive). Never commit these: they are the
# held-out set, and the discipline that makes them worth having is that they
# are inspected exactly once, at final validation.
datasets/heldout/

# Per-repetition artifact trees written by benchmarks/bench.py.
#
# These are scratch, not evidence. The gate compares each repetition's outputs and
# then the directory can be thrown away and regenerated by re-running the study --
# a single bam2wig repetition writes a ~486 MB WIG, and a 17-command 5-repetition
# study leaves about 6 GB of it behind. The EVIDENCE is the JSON beside these
# directories: raw per-run timings, exit codes, output-validation results, the
# interleaved schedule, failures with stderr, and the full provenance block. That is
# what the protocol asks to be archived, and it is committed.
#
# Ignored by depth so the JSON is kept: results-<label>/<command>/<arm>/repNN/
benchmarks/results-*/*/*/rep*/

# Upstream's `printlog` appends to `log.txt` in the CURRENT DIRECTORY, so running any
# upstream script from the repository root leaves a stray log behind. It is a run
# artifact, not a source file.
log.txt
